APP_MODE=dev
LOGGER_LEVEL=debug

SERVER_HTTP_PORT=8080
SERVER_GRPC_PORT=8100

COOKIE_DOMAIN=travelbook.localhost

AUTH_AUDIENCE=https://travelbook.suphawit.dev/auth,https://travelbook.localhost/auth
AUTH_OAUTH_GOOGLE_CLIENT_ID=YOUR_VALUE.apps.googleusercontent.com
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=YOUR_VALUE

SECURITY_CORS_ALLOWED_ORIGINS=https://travelbook.suphawit.dev,https://travelbook.localhost
SECURITY_JWT_ISSUER=https://api.travelbook.suphawit.dev
SECURITY_VAULT_ADDRESS=http://vault:8200
SECURITY_VAULT_TOKEN=root

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://pguser:pgPass3210@db:5432/tb_auth_db?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations

DB_POSTGRES_HOST=db
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=pguser
DB_POSTGRES_PASSWORD=pgPass3210
DB_POSTGRES_DB_NAME=tb_auth_db

DB_REDIS_ADDR=redis:6379
DB_REDIS_USERNAME=default
DB_REDIS_PASSWORD=redisPass12345
DB_REDIS_DB=0

MESSAGING_KAFKA_CLUSTER_BROKERS=kafka:9092
MESSAGING_KAFKA_CLUSTER_SECURITY_PROTOCOL=PLAINTEXT
