  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/parser": "^7.18.0",
    "@vercel/style-guide": "^6.0.0",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "eslint-plugin-header": "^3.1.1",
    "plop": "^4.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "standard-version": "^9.5.0",
    "typescript": "^5"
  }
}
