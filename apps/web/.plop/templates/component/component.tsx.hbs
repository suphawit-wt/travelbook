{{#if hasStyled}}import { Wrapper } from './{{kebabCase name}}.styled';{{/if}}

export const {{pascalCase name}} = ({{#if hasTypes}}{ children, ...props }: {{pascalCase name}}Props{{/if}}) => {
  return (
    {{#if hasStyled}}
    <Wrapper{{#if hasTypes}} {...props}{{/if}}>
