{
    "swagger": "2.0",
    "info": {
        "description": "Auth Service handles authentication and authorization for the Travelbook ecosystem.",
        "title": "Auth Service - Travelbook API",
        "termsOfService": "https://suphawit.dev/terms/",
        "contact": {
            "name": "Suphawit Watthanataetakun",
            "url": "https://suphawit.dev/support",
            "email": "support@suphwit.dev"
        },
        "license": {
            "name": "Creative Commons Attribution-NonCommercial-NoDerivatives 4.0",
            "url": "https://creativecommons.org/licenses/by-nc-nd/4.0"
        },
        "version": "1.0.0"
    },
    "host": "api.travelbook.localhost",
    "basePath": "/",
    "paths": {
        "/v1/auth/user/sign-in": {
            "post": {
                "description": "Authenticate user and return access + refresh token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Sign in user",
                "parameters": [
                    {
                        "description": "User credentials",
                        "name": "req",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.UserSignInRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth.ApiResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/auth.ApiResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "errors": {
                                            "$ref": "#/definitions/auth.ErrResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/auth.ApiResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.ApiResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "statusCode": {
                    "type": "integer"
                }
            }
        },
        "auth.ErrResponse": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "auth.UserSignInRequest": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 254
                }
            }
        }
    },
    "securityDefinitions": {
        "Bearer": {
            "description": "Put **_ONLY_** your JWT Bearer token in textbox below",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    },
    "externalDocs": {
        "description": "OpenAPI",
        "url": "https://swagger.io/resources/open-api/"
    }
}