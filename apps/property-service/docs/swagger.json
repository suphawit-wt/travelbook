{
    "swagger": "2.0",
    "info": {
        "description": "Property Service is a microservice that provides property search and filtering functionality.",
        "title": "Property Service - Travelbook API",
        "termsOfService": "https://suphawit.dev/terms/",
        "contact": {
            "name": "Suphawit Watthanataetakun",
            "url": "https://suphawit.dev/support",
            "email": "support@suphwit.dev"
        },
        "license": {
            "name": "Creative Commons Attribution-NonCommercial-NoDerivatives 4.0",
            "url": "https://creativecommons.org/licenses/by-nc-nd/4.0"
        },
        "version": "1.0.0"
    },
    "host": "api.travelbook.localhost",
    "basePath": "/",
    "paths": {
        "/v1/properties": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "Create a new property",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Properties"
                ],
                "summary": "Create property",
                "parameters": [
                    {
                        "description": "CreatePropertyRequest",
                        "name": "req",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/property.CreatePropertyRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/property.ApiResponseWithData"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/property.CreatePropertyResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/property.ApiResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "errors": {
                                            "$ref": "#/definitions/property.ErrResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/property.ApiResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/property.ApiResponse"
                        }
                    }
                }
            }
        },
        "/v1/properties/{id}/location": {
            "patch": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "Update the location details of an existing property, including address, city, state, postal code, and country.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Properties"
                ],
                "summary": "Update property location",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Property ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "UpdatePropertyLocationRequest",
                        "name": "req",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/property.UpdatePropertyLocationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/property.ApiResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/property.ApiResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "errors": {
                                            "$ref": "#/definitions/property.ErrResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/property.ApiResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/property.ApiResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "property.ApiResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "statusCode": {
                    "type": "integer"
                }
            }
        },
        "property.ApiResponseWithData": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                },
                "statusCode": {
                    "type": "integer"
                }
            }
        },
        "property.CreatePropertyRequest": {
            "type": "object",
            "required": [
                "checkInFrom",
                "checkInUntil",
                "checkOutFrom",
                "checkOutUntil",
                "name",
                "timezone",
                "type"
            ],
            "properties": {
                "checkInFrom": {
                    "type": "string"
                },
                "checkInUntil": {
                    "type": "string"
                },
                "checkOutFrom": {
                    "type": "string"
                },
                "checkOutUntil": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "maxLength": 90
                },
                "timezone": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/definitions/property.Type"
                }
            }
        },
        "property.CreatePropertyResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "slug": {
                    "type": "string"
                },
                "timezone": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/definitions/property.Type"
                }
            }
        },
        "property.ErrResponse": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "property.Type": {
            "type": "string",
            "enum": [
                "hotel",
                "apartment",
                "resort",
                "villa",
                "cabin"
            ],
            "x-enum-varnames": [
                "TypeHotel",
                "TypeApartment",
                "TypeResort",
                "TypeVilla",
                "TypeCabin"
            ]
        },
        "property.UpdatePropertyLocationRequest": {
            "type": "object",
            "required": [
                "addressLine1",
                "areaId",
                "latitude",
                "longitude",
                "zipCode"
            ],
            "properties": {
                "addressLine1": {
                    "type": "string",
                    "maxLength": 80
                },
                "addressLine2": {
                    "type": "string",
                    "maxLength": 80
                },
                "areaId": {
                    "type": "string"
                },
                "latitude": {
                    "type": "number"
                },
                "longitude": {
                    "type": "number"
                },
                "zipCode": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "Bearer": {
            "description": "Put **_ONLY_** your JWT Bearer token in textbox below",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    },
    "externalDocs": {
        "description": "OpenAPI",
        "url": "https://swagger.io/resources/open-api/"
    }
}