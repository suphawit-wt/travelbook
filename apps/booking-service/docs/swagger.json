{
    "swagger": "2.0",
    "info": {
        "description": "Booking Service. This service allows users to search for properties, manage bookings.",
        "title": "Booking Service - Travelbook API",
        "termsOfService": "https://suphawit.dev/terms/",
        "contact": {
            "name": "Suphawit Watthanataetakun",
            "url": "https://suphawit.dev/support",
            "email": "support@suphwit.dev"
        },
        "license": {
            "name": "Creative Commons Attribution-NonCommercial-NoDerivatives 4.0",
            "url": "https://creativecommons.org/licenses/by-nc-nd/4.0"
        },
        "version": "1.0.0"
    },
    "host": "api.travelbook.localhost",
    "basePath": "/",
    "paths": {
        "/v1/bookings": {
            "post": {
                "description": "Create a new booking for a user",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Bookings"
                ],
                "summary": "Create booking",
                "parameters": [
                    {
                        "description": "Booking creation payload",
                        "name": "req",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/booking.CreateBookingRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/booking.ApiResponseWithData"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/booking.CreateBookingResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/booking.ApiResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "errors": {
                                            "$ref": "#/definitions/booking.ErrResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/booking.ApiResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/booking.ApiResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "booking.ApiResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "statusCode": {
                    "type": "integer"
                }
            }
        },
        "booking.ApiResponseWithData": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                },
                "statusCode": {
                    "type": "integer"
                }
            }
        },
        "booking.CreateBookingRequest": {
            "type": "object",
            "required": [
                "checkIn",
                "checkOut",
                "guests",
                "propertyId",
                "rooms"
            ],
            "properties": {
                "checkIn": {
                    "type": "string"
                },
                "checkOut": {
                    "type": "string"
                },
                "guests": {
                    "$ref": "#/definitions/booking.guestRequest"
                },
                "propertyId": {
                    "type": "string"
                },
                "rooms": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/booking.roomRequest"
                    }
                }
            }
        },
        "booking.CreateBookingResponse": {
            "type": "object",
            "properties": {
                "bookingId": {
                    "type": "string"
                },
                "expiresAt": {
                    "type": "string"
                }
            }
        },
        "booking.ErrResponse": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "booking.guestRequest": {
            "type": "object",
            "required": [
                "adults"
            ],
            "properties": {
                "adults": {
                    "type": "integer",
                    "minimum": 1
                },
                "children": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "booking.roomRequest": {
            "type": "object",
            "required": [
                "quantity",
                "ratePlanId",
                "roomTypeId"
            ],
            "properties": {
                "quantity": {
                    "type": "integer",
                    "minimum": 1
                },
                "ratePlanId": {
                    "type": "string"
                },
                "roomTypeId": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "Bearer": {
            "description": "Put **_ONLY_** your JWT Bearer token in textbox below",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    },
    "externalDocs": {
        "description": "OpenAPI",
        "url": "https://swagger.io/resources/open-api/"
    }
}